# ============================================================
# RASTRO BACKEND — Variables de Entorno
# Copia este archivo como .env y completa los valores marcados
# con <REEMPLAZAR>. Los valores predeterminados son para
# desarrollo local con Docker / Sail.
# ============================================================

# ------------------------------------------------------------
# APLICACIÓN
# ------------------------------------------------------------
APP_NAME=Rastro
APP_ENV=local
# Generar con: php artisan key:generate
APP_KEY=
APP_DEBUG=true
# URL local del servidor de desarrollo
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_EC
APP_DISPLAY_TIMEZONE="America/Guayaquil"

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ------------------------------------------------------------
# LOGS
# ------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------
# BASE DE DATOS
# Desarrollo local: PostgreSQL 16 vía Docker / Sail
# Producción: Neon (PostgreSQL serverless) — configurar en
# el dashboard de Render, no en este archivo.
# ------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=rastro
DB_USERNAME=sail
DB_PASSWORD=password

# ------------------------------------------------------------
# SESIONES
# ------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ------------------------------------------------------------
# BROADCASTING, FILESYSTEM Y COLAS
# ------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ------------------------------------------------------------
# CACHÉ
# ------------------------------------------------------------
CACHE_STORE=database

# ------------------------------------------------------------
# CORREO TRANSACCIONAL
# En desarrollo: 'log' escribe los correos en los logs de
# Laravel en lugar de enviarlos. En producción reemplazar
# con las credenciales del proveedor SMTP real.
# ------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Para Resend sin dominio verificado usar: onboarding@resend.dev
# Con dominio propio verificado en Resend DNS: noreply@tudominio.com
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_NOTIFICATION_EMAIL="bitwave.company@gmail.com"
ADMIN_DASHBOARD_URL="https://rastro-ec.vercel.app/admin/login"

# ------------------------------------------------------------
# SANCTUM — TOKENS DE AUTENTICACIÓN
# ACCESS_TOKEN_TTL: minutos de vida del access token (60 = 1h)
# REFRESH_TOKEN_TTL: días de vida del refresh token (30 días)
# ------------------------------------------------------------
SANCTUM_ACCESS_TOKEN_TTL=60
SANCTUM_REFRESH_TOKEN_TTL=30

# ------------------------------------------------------------
# REDIS (no usado activamente en el MVP — reservado)
# ------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------
# AWS S3 (no usado en el MVP — reservado para adjuntos futuros)
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------
# VITE (no aplica en API pura — dejar como está)
# ------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"